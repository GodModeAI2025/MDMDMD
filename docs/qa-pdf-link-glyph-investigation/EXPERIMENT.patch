@@ -50,6 +50,40 @@ struct PDFTextTypesetter {
             try PDFLineDecorations.drawStrikes(coreTextLine, context: context, baseline: baseline)
         }
 
+        /// Reuses the original shaped glyph runs and positions. The callback
+        /// can assign each run to its logical structure owner without reshaping.
+        func drawRuns(in context: CGContext, baseline: CGPoint,
+                      draw: (CTRun, () -> Void) throws -> Void) throws {
+            try Task.checkCancellation()
+            let matrix = context.textMatrix, position = context.textPosition
+            context.saveGState()
+            defer { context.restoreGState(); context.textMatrix = matrix; context.textPosition = position }
+            context.textMatrix = .identity
+            for run in CTLineGetGlyphRuns(coreTextLine) as! [CTRun] {
+                try Task.checkCancellation()
+                context.textPosition = baseline
+                try draw(run) {
+                    let attributes = CTRunGetAttributes(run) as NSDictionary
+                    if let value = attributes[kCTFontAttributeName as String], CFGetTypeID(value as CFTypeRef) == CTFontGetTypeID(),
+                       (CTFontGetSymbolicTraits(value as! CTFont).rawValue & (1 << 13)) != 0 {
+                        let font = value as! CTFont
+                        let count = CTRunGetGlyphCount(run)
+                        var glyphs = [CGGlyph](repeating: 0, count: count)
+                        var positions = [CGPoint](repeating: .zero, count: count)
+                        CTRunGetGlyphs(run, CFRange(location: 0, length: 0), &glyphs)
+                        CTRunGetPositions(run, CFRange(location: 0, length: 0), &positions)
+                        for index in positions.indices { positions[index].x += baseline.x; positions[index].y += baseline.y }
+                        CTFontDrawGlyphs(font, glyphs, positions, count, context)
+                    } else { CTRunDraw(run, context, CFRange(location: 0, length: 0)) }
+                }
+            }
+            if #available(iOS 27.0, macOS 27.0, *) {
+                context.beginNonStructuralMarkedContentSequence(.artifact)
+                defer { context.endMarkedContentSequence() }
+                try PDFLineDecorations.drawStrikes(coreTextLine, context: context, baseline: baseline)
+            } else { try PDFLineDecorations.drawStrikes(coreTextLine, context: context, baseline: baseline) }
+        }
+
         func linkRegions(baseline: CGPoint) throws -> [PDFLinkRegion] {
             try Task.checkCancellation()
             return try PDFLineDecorations.links(coreTextLine, baseline: baseline)
