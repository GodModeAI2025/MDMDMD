# Native UI hierarchy captures contain literal document whitespace and CRLF.
# Preserve their bytes rather than normalizing or linting the observed source.
docs/qa*/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Preserve original upstream license bytes and recorded compiler output.
docs/licenses/native-engine-research-20261015/notice-texts/*.txt -text -whitespace
docs/qa-native-resource-pack-20261015/*.log -text -whitespace
docs/qa-native-worker-20261015/**/*.log -text -whitespace
docs/qa-native-worker-20261015/*.log -text -whitespace

# Keep native-image agent metadata byte-identical to the compiler inputs.
Research/NativeWritingQuality/NativeConfig/*.json -text -whitespace

# Original distribution notices and build receipts retain upstream bytes.
docs/licenses/native-engine-distribution-20261015/**/*.txt -text -whitespace conflict-marker-size=32
docs/qa-native-distribution-20261015/**/*.log -text -whitespace
docs/qa-native-distribution-20261015/*.log -text -whitespace
docs/qa-native-distribution-20261015/OpenRegex-1.1.1-LICENSE.txt -text -whitespace
docs/qa-native-distribution-20261015/framework-verified/*.swift -text -whitespace
docs/qa-mac-ui-20261015/*.log -text -whitespace
docs/licenses/native-engine-source-bindings-20261015/**/*.txt -text -whitespace conflict-marker-size=32
docs/qa-native-source-bindings-20261015/*.log -text -whitespace
