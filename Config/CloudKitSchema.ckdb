DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE ScriptumItemV1 (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        libraryID STRING,
        kind STRING,
        uuid STRING,
        revision STRING,
        operation STRING,
        sha256 STRING,
        payload ASSET,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE ScriptumSharedImageV1 (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        libraryID STRING,
        kind STRING,
        uuid STRING,
        revision STRING,
        operation STRING,
        sha256 STRING,
        payload ASSET,
        sourceRecordName STRING,
        GRANT WRITE TO "_creator"
    );
