<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.mobilebox.research</groupId>
    <artifactId>scriptum-native-writing-quality</artifactId>
    <version>0.0.1</version>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <gluonfx.target>ios</gluonfx.target>
        <scriptum.buildDirectory>${project.basedir}/target</scriptum.buildDirectory>
        <scriptum.agentDirectory>${project.basedir}/NativeConfig</scriptum.agentDirectory>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.languagetool</groupId>
            <artifactId>language-all</artifactId>
            <version>6.6</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.nativeimage</groupId>
            <artifactId>library-support</artifactId>
            <version>22.0.0.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <directory>${scriptum.buildDirectory}</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>com.gluonhq</groupId>
                <artifactId>gluonfx-maven-plugin</artifactId>
                <version>1.0.29</version>
                <configuration>
                    <target>${gluonfx.target}</target>
                    <mainClass>com.mobilebox.research.NativeWritingQuality</mainClass>
                    <graalvmHome>${scriptum.graalvmHome}</graalvmHome>
                    <javaStaticSdkVersion>24-2</javaStaticSdkVersion>
                    <nativeImageArgs>
                        <arg>--no-fallback</arg>
                        <arg>-H:ConfigurationFileDirectories=${scriptum.agentDirectory}</arg>
                        <arg>--initialize-at-run-time=org.languagetool,ch.qos.logback,io.grpc.netty.shaded.io.netty</arg>
                        <arg>-H:+ReportExceptionStackTraces</arg>
                    </nativeImageArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>external-resources</id>
            <build><plugins><plugin>
                <groupId>com.gluonhq</groupId><artifactId>gluonfx-maven-plugin</artifactId>
                <configuration><nativeImageArgs combine.children="append">
                    <arg>-H:ExcludeResources=org/languagetool/(rules/.*|resource/(?!ga/filter-archaic\.txt$).*)</arg>
                </nativeImageArgs></configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
